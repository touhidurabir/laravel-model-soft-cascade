{
    "name": "touhidurabir/laravel-model-soft-cascade",
    "description": "A laravel package to handle cascade delete and restore on model relations.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Touhidurabir\\ModelSoftCascade\\": "src/"
        }
    },
    "autoload-dev" : {
        "psr-4" : {
            "Touhidurabir\\ModelSoftCascade\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Touhidur Rahman",
            "email": "abircse06@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.5||^10.0||^11.0||^12.0",
        "orchestra/testbench": "^6.21||^7.0||^8.0||^9.0||^10.0||^11.0",
        "illuminate/support": "^8.62||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/database": "^8.62||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/events": "^8.62||^9.0||^10.0||^11.0||^12.0||^13.0"
    },
    "require": {
        "php": ">=7.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Touhidurabir\\ModelSoftCascade\\ModelSoftCascadeServiceProvider"
            ]
        }
    }
}
